{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/tools/pixelshrink/(.*)\\.(wasm|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/pixelshrink/heic-to.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/bd-telecom/(.*)\\.csv",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bd-telecom/docs/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/imtiaz99000/Portfolio-site@979acba772ebc926b8c1685c5f17e54280fdcbf3/bd-telecom/docs/:path*",
      "permanent": false
    },
    {
      "source": "/work/:slug/:file(.*\\.pdf)",
      "destination": "https://cdn.jsdelivr.net/gh/imtiaz99000/Portfolio-site@979acba772ebc926b8c1685c5f17e54280fdcbf3/work/:slug/:file",
      "permanent": false
    },
    {
      "source": "/tools/taka-gelo-koi",
      "destination": "https://taka.imtiazkarim.com/",
      "permanent": true
    },
    {
      "source": "/tools/taka-gelo-koi/:path*",
      "destination": "https://taka.imtiazkarim.com/",
      "permanent": true
    }
  ]
}
