{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/tools/pixelshrink/(.*)\\.(wasm|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tools/pixelshrink/heic-to.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/taka-gelo-koi",
      "destination": "https://taka.imtiazkarim.com/",
      "permanent": true
    },
    {
      "source": "/tools/taka-gelo-koi/:path*",
      "destination": "https://taka.imtiazkarim.com/",
      "permanent": true
    }
  ]
}
